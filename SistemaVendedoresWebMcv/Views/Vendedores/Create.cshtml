@model SistemaVendedoresWebMcv.Models.ViewModels.VendedorFormViewModel
@{
	ViewData["Title"] = "Criar";
}
<br />
<h1>@ViewData["Title"]</h1>

<h4>Vendedores</h4>
<hr />
<div class="row">
	<div class="col-md-4">
		<form asp-action="Create">
			<div class="form-group">
				<label asp-for="Vendedor.Nome" class="contol-label"></label>
				<input asp-for="Vendedor.Nome" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Vendedor.Email" class="contol-label"></label>
				<input asp-for="Vendedor.Email" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Vendedor.DataNascimento" class="contol-label"></label>
				<input asp-for="Vendedor.DataNascimento" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Vendedor.SalarioBase" class="contol-label"></label>
				<input asp-for="Vendedor.SalarioBase" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Vendedor.DepartamentoId" class="contol-label"></label>
				<select asp-for="Vendedor.DepartamentoId" class="form-control" asp-items="@(new SelectList(Model.Departamentos, "Id", "Nome"))"></select>
			</div>
			<br />
			<div class="form-group">
				<input type="submit" value="Criar" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>

<div>
	<a asp-action="Index">Voltar</a>
</div>