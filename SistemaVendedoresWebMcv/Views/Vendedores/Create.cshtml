@model SistemaVendedoresWebMcv.Models.Vendedor
@{
	ViewData["Title"] = "Criar";
}
<br />
<h1>@ViewData["Title"]</h1>

<h4>Vendedores</h4>
<hr />
<div class="row">
	<div class="col-md-4">
		<form asp-action="Create">
			<div class="form-group">
				<label asp-for="Nome" class="contol-label"></label>
				<input asp-for="Nome" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Email" class="contol-label"></label>
				<input asp-for="Email" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="DataNascimento" class="contol-label"></label>
				<input asp-for="DataNascimento" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="SalarioBase" class="contol-label"></label>
				<input asp-for="SalarioBase" class="form-control" />
			</div>
			<br />
			<div class="form-group">
				<input type="submit" value="Criar" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>

<div>
	<a asp-action="Index">Voltar</a>
</div>